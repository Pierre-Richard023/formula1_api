                                "short_name": "Miami",
                                "country": {
                                "name": "United States of America",
                                "continent": "North America"
                            }
                            },
                            {
                                "circuitsId": "catalunya",
                                "name": "Circuit de Barcelona-Catalunya",
                                "short_name": "Catalunya",
                                "country": {
                                "name": "Spain",
                                "continent": "Europe"
                            }
                            },
                            {
                                "circuitsId": "monaco",
                                "name": "Circuit de Monaco",
                                "short_name": "Monaco",
                                "country": {
                                "name": "Monaco",
